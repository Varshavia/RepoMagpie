{
  "name": "repomagpie",
  "version": "0.2.0-beta.14",
  "description": "Remembers what you and your team learned about every dependency, and tells your coding agent before it installs one.",
  "keywords": [
    "dependencies",
    "coding-agent",
    "claude-code",
    "agent-skills",
    "cli",
    "markdown",
    "notes"
  ],
  "homepage": "https://github.com/Varshavia/RepoMagpie#readme",
  "bugs": {
    "url": "https://github.com/Varshavia/RepoMagpie/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Varshavia/RepoMagpie.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "repomagpie": "dist/cli/main.js",
    "magpie": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node scripts/test.ts",
    "test:hooks": "node --test \".claude/hooks/*.test.mjs\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "build": "node scripts/build-cli.ts && vite build ui",
    "dev:ui": "vite ui",
    "check:bundle": "node scripts/check-bundle.ts",
    "check:build": "node scripts/check-build.ts",
    "test:e2e": "playwright test -c ui/playwright.config.ts",
    "bench": "npm run build && node scripts/bench-search.ts && node scripts/bench-catalog.ts && node scripts/bench-suggest.ts && node scripts/bench-recall.ts && node scripts/bench-links.ts && node scripts/bench-graph.ts && node scripts/bench-note.ts && node scripts/bench-mcp.ts",
    "eval:retrieval": "node scripts/eval-retrieval.ts",
    "eval:classification": "node scripts/eval-classification.ts",
    "measure": "node scripts/measure.ts",
    "release:tag": "node scripts/tag-release.ts",
    "check:links": "node scripts/check-links.ts",
    "check:commands": "node scripts/check-commands.ts",
    "check:characters": "node scripts/check-characters.ts",
    "check:fs-calls": "node scripts/check-fs-calls.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "commander": "15.0.0",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "graphology-types": "0.24.8",
    "minisearch": "7.2.0",
    "packageurl-js": "2.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sigma": "3.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "yaml": "2.9.1"
  }
}
