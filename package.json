{
  "name": "repomagpie",
  "version": "0.0.0",
  "description": "Remembers what you and your team learned about every dependency, and tells your coding agent before it installs one.",
  "keywords": [
    "dependencies",
    "coding-agent",
    "claude-code",
    "agent-skills",
    "cli",
    "markdown",
    "notes"
  ],
  "homepage": "https://github.com/Varshavia/RepoMagpie#readme",
  "bugs": {
    "url": "https://github.com/Varshavia/RepoMagpie/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Varshavia/RepoMagpie.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "magpie": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node scripts/test.ts",
    "test:hooks": "node --test \".claude/hooks/*.test.mjs\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "build": "tsc -p tsconfig.build.json && vite build ui",
    "dev:ui": "vite ui",
    "check:bundle": "node scripts/check-bundle.ts",
    "test:e2e": "playwright test -c ui/playwright.config.ts",
    "bench": "npm run build && node scripts/bench-search.ts && node scripts/bench-recall.ts",
    "check:links": "node scripts/check-links.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "15.0.0",
    "minisearch": "7.2.0",
    "packageurl-js": "2.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
