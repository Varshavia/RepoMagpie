{
  "name": "repomagpie",
  "version": "0.3.0-beta.1",
  "description": "Your coding agent remembers the repos you've tried, and what you thought of them.",
  "author": {
    "name": "Varshavia",
    "url": "https://github.com/Varshavia"
  },
  "homepage": "https://github.com/Varshavia/RepoMagpie#readme",
  "repository": "https://github.com/Varshavia/RepoMagpie",
  "license": "MIT",
  "keywords": ["dependencies", "notes", "mcp", "hooks", "skills"],
  "mcpServers": {
    "repomagpie": {
      "command": "node",
      "args": ["--disallow-code-generation-from-strings", "${CLAUDE_PLUGIN_ROOT}/dist/cli/main.js", "mcp"],
      "env": {
        "REPOMAGPIE_ALLOW_WRITE": "${user_config.note_tool}"
      }
    }
  },
  "userConfig": {
    "note_tool": {
      "type": "boolean",
      "title": "Note tool",
      "description": "Lets Claude save your Verdict on a package to your notes, in your words. Off: Claude only reads your notes.",
      "default": true
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--disallow-code-generation-from-strings", "${CLAUDE_PLUGIN_ROOT}/dist/cli/main.js", "hook", "claude-code"]
          }
        ]
      }
    ]
  }
}
